{
  "name": "epoc-player",
  "version": "3.0.1",
  "author": "Inria Learning Lab",
  "homepage": "https://epoc.inria.fr",
  "scripts": {
    "build": "ionic build",
    "build-preview": "VITE_APP_MODE=preview ionic build",
    "dev": "ionic serve",
    "dev-preview": "VITE_APP_MODE=preview ionic serve",
    "android": "source .env; npm run resources && ionic cap run android $ANDROID_TARGET; node scripts/fix-config.js",
    "android-release": "npm run resources && ionic cap sync && ionic cap open android; node scripts/fix-config.js",
    "android-dev": "source .env; npm run resources && ionic cap run android $ANDROID_TARGET --livereload-url=http://localhost:8100; node scripts/fix-config.js",
    "ios": "source .env; npm run resources && ionic cap sync && ionic cap run ios $IOS_TARGET; node scripts/fix-config.js",
    "ios-release": "npm run resources && ionic cap open ios; node scripts/fix-config.js",
    "ios-dev": "source .env; npm run resources && ionic cap run ios $IOS_TARGET --livereload-url=http://localhost:8100; node scripts/fix-config.js",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint .",
    "resources": "rm -rf resources/* && cp -R resources-common/* resources/ && npx capacitor-assets generate",
    "store:screenshots": "node scripts/store-screenshots/capture.mjs"
  },
  "private": true,
  "dependencies": {
    "@capacitor/android": "~8.4.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "~8.4.3",
    "@capacitor/core": "~8.4.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/file-viewer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "~8.4.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/screen-reader": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@epoc/capacitor-zip": "^0.1.2",
    "@epoc/epoc-types": "^2.0.0-beta.26",
    "@ionic/cli": "^7.2.1",
    "@ionic/storage": "^3.0.6",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^18.19.130",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "@vueuse/core": "^14.1.0",
    "cordova-sqlite-storage": "^7.0.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "glightbox": "^3.3.0",
    "ionicons": "^8.1.0",
    "jsdom": "^22.1.0",
    "json-logic-js": "^2.0.5",
    "jspdf": "^4.0.0",
    "katex": "^0.16.9",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "mermaid": "^10.8.0",
    "motion-v": "^1.9.0",
    "pinia": "^3.0.3",
    "sass": "^1.97.0",
    "swiper": "^10.3.1",
    "terser": "^5.4.0",
    "tslib": "^2.4.0",
    "typescript": "~5.6.2",
    "vite": "~5.2.0",
    "vitest": "^0.34.6",
    "vtt.js": "^0.13.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.12",
    "vue-matomo": "^4.2.0",
    "vue-router": "^4.2.0",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "rollup": "4.44.0"
  },
  "description": "Lecteur web et mobile d'ePoc (Electronic Pocket Open Course)",
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
