# Copy to fastlane/.env (git-ignored) and fill in. Keep the key files outside the repository.

# App Store Connect API key, fastlane JSON format:
# { "key_id": "XXXX", "issuer_id": "xxxx-xxxx", "key": "-----BEGIN PRIVATE KEY-----\n...", "in_house": false }
ASC_API_KEY_PATH=/path/to/asc_api_key.json
# Or, without API key: log in with an Apple ID (password and 2FA asked in the terminal)
# FASTLANE_USER=apple-id@example.com

# Google Play service account JSON key
PLAY_JSON_KEY_PATH=/path/to/play-service-account.json

# Android upload keystore (the one used to sign the AAB sent to Google Play)
ANDROID_KEYSTORE_PATH=/path/to/upload.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Gradle needs JDK 17 or 21 (not the system default if it is newer)
JAVA_HOME=/path/to/jdk-21/Contents/Home
