require "json"

# package.json is the single source of truth for the version name
ROOT = File.expand_path("..", __dir__)
VERSION = JSON.parse(File.read(File.join(ROOT, "package.json")))["version"]

IOS_METADATA = File.join(ROOT, "fastlane/metadata/ios")
IOS_SCREENSHOTS = File.join(ROOT, "fastlane/screenshots/ios")
ANDROID_METADATA = File.join(ROOT, "fastlane/metadata/android")
BUILD_DIR = File.join(ROOT, "fastlane/build")

desc "Generate localized store screenshots (iOS + Android) from the web app"
lane :screenshots do |options|
  args = []
  args += ["--lang", options[:lang]] if options[:lang]
  args += ["--device", options[:device]] if options[:device]
  sh_root("node", "scripts/store-screenshots/capture.mjs", *args)
end

# fastlane's sh runs from fastlane/, run project commands from the repository root
def sh_root(*command)
  Dir.chdir(ROOT) { sh(*command) }
end

def build_web
  sh_root("npm", "run", "build")
end

platform :ios do
  # Without an API key, fastlane logs in with the Apple ID in FASTLANE_USER (password and 2FA prompted)
  def asc_api_key
    UI.user_error!("Set ASC_API_KEY_PATH or FASTLANE_USER (see fastlane/.env.example)") unless ENV["ASC_API_KEY_PATH"] || ENV["FASTLANE_USER"]
    ENV["ASC_API_KEY_PATH"]
  end

  desc "Download the current App Store texts and screenshots (into fastlane/metadata/ios, or path:<dir>)"
  lane :pull_metadata do |options|
    auth = asc_api_key ? ["--api_key_path", asc_api_key] : []
    app = ["--app_identifier", CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)]
    metadata_path = options[:path] ? File.join(File.expand_path(options[:path]), "metadata") : IOS_METADATA
    sh("bundle", "exec", "fastlane", "deliver", "download_metadata", *auth, *app,
       "--metadata_path", metadata_path, "--force")
    if options[:path]
      sh("bundle", "exec", "fastlane", "deliver", "download_screenshots", *auth, *app,
         "--screenshots_path", File.join(File.expand_path(options[:path]), "screenshots"))
    end
  end

  desc "Upload texts (and screenshots with screenshots:true) to the App Store version being prepared"
  lane :metadata do |options|
    upload_to_app_store(
      api_key_path: asc_api_key,
      app_version: VERSION,
      metadata_path: IOS_METADATA,
      screenshots_path: IOS_SCREENSHOTS,
      skip_binary_upload: true,
      skip_screenshots: !options[:screenshots],
      overwrite_screenshots: true,
      skip_app_version_update: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Build a signed App Store IPA (version from package.json, build number = TestFlight latest + 1)"
  lane :build do
    build_number = latest_testflight_build_number(api_key_path: asc_api_key, initial_build_number: 0) + 1
    build_web
    sh_root("npx", "cap", "sync", "ios")
    build_app(
      workspace: File.join(ROOT, "ios/App/App.xcworkspace"),
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: BUILD_DIR,
      output_name: "ePoc-#{VERSION}-#{build_number}.ipa",
      xcargs: "MARKETING_VERSION=#{VERSION} CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(api_key_path: asc_api_key, skip_waiting_for_build_processing: true)
  end

  desc "Submit the latest TestFlight build of this version for App Store review, with texts and screenshots"
  lane :release do |options|
    upload_to_app_store(
      api_key_path: asc_api_key,
      app_version: VERSION,
      build_number: latest_testflight_build_number(api_key_path: asc_api_key, version: VERSION).to_s,
      metadata_path: IOS_METADATA,
      screenshots_path: IOS_SCREENSHOTS,
      skip_binary_upload: true,
      skip_screenshots: !!options[:skip_screenshots],
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: options[:automatic_release] || false,
      submission_information: { add_id_info_uses_idfa: false },
      run_precheck_before_submit: false,
      force: true
    )
  end
end

platform :android do
  def latest_version_code
    %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(track: track)
    rescue StandardError
      []
    end.max || 0
  end

  desc "Download the current Play Store texts and images into fastlane/metadata/android"
  lane :pull_metadata do
    download_from_play_store(metadata_path: ANDROID_METADATA)
  end

  desc "Upload texts, images and screenshots to the Play Store listing"
  lane :metadata do
    upload_to_play_store(
      metadata_path: ANDROID_METADATA,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true
    )
  end

  desc "Build a signed release AAB (version from package.json, version code = Play latest + 1)"
  lane :build do
    %w[ANDROID_KEYSTORE_PATH ANDROID_KEYSTORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD].each do |var|
      UI.user_error!("#{var} is not set (see fastlane/.env.example)") unless ENV[var]
    end
    version_code = latest_version_code + 1
    build_web
    sh_root("npx", "cap", "sync", "android")
    sh_root("node", "scripts/fix-config.js")
    gradle(
      project_dir: File.join(ROOT, "android"),
      task: "bundle",
      build_type: "Release",
      properties: {
        "versionCode" => version_code,
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )
  end

  desc "Build and upload to the internal testing track"
  lane :beta do
    build
    upload_to_play_store(
      track: "internal",
      release_status: "completed",
      metadata_path: ANDROID_METADATA,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the latest internal build to production (rollout:0.2 for a staged rollout), with listing"
  lane :release do |options|
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: google_play_track_version_codes(track: "internal").max,
      rollout: options[:rollout]&.to_s,
      release_status: options[:rollout] ? "inProgress" : "completed",
      metadata_path: ANDROID_METADATA,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_screenshots: !!options[:skip_screenshots]
    )
  end
end
